# 博客园 MetaWeblog 配置
#
# 复制本文件为 .cnblogs.env 并填好。
# 查找顺序：脚本同目录 -> 当前工作目录 -> 用户主目录；
# 也可以用同名的环境变量覆盖（环境变量优先）。
#
# ⚠️ 不要把填好的 .cnblogs.env 提交到任何仓库（.gitignore 已排除）。

# 令牌获取步骤：
#   1. 登录博客园后台 -> 设置 -> 其他设置
#   2. 勾选「允许 MetaWeblog 博客客户端访问」
#   3. 页面会显示 MetaWeblog 登录名；再点「生成访问令牌」并复制
#
# 注意：博客园已取消密码登录，这里必须是「访问令牌」，不是你的登录密码。
# 令牌等价于账号密码，但可以在后台随时吊销。

CNBLOGS_API_URL=https://rpc.cnblogs.com/metaweblog/YOUR_BLOG_NAME
CNBLOGS_USERNAME=YOUR_METAWEBLOG_USERNAME
CNBLOGS_TOKEN=YOUR_ACCESS_TOKEN

# 可选：MetaWeblog 的 blogid。博客园用不到，留空即可。
CNBLOGS_BLOG_ID=

# 可选：站点首页前缀，仅 delete_posts.py 的删后探活会用到。
# 留空时会自动从接口返回的 permaLink 推断，一般不用填。
CNBLOGS_HOME=

# 可选：新建草稿时的默认分类。
CNBLOGS_DEFAULT_CATEGORY=随笔分类
